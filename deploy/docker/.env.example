# Copy to .env next to compose.yaml. Only bare `docker compose` commands read
# .env; the verification harness (e2e/with-compose-stack.sh) takes its
# defaults from e2e/support/common.sh and e2e/support/env-compose.sh and passes
# them to compose through the environment. The values here equal those
# defaults, so a knob changed in one file is changed in the other, and the
# harness refuses `latest` for the two image tags.

# Tag of the locally built apf-policy-service and apf-policy-gateway images.
APF_IMAGE_TAG=dev

# Key id of the bundle signing key; also the trust-root file stem (<id>.pub)
# and the document key id both binaries use.
APF_KEY_ID=apf-dev

# Signed bundle directory (holds manifest.yaml and the members) and the trust
# root, both bind-mounted read-only. compose.yaml alone defaults to ./bundle;
# `e2e/with-compose-stack.sh --prepare` signs the demo bundle into the
# harness work directory named here.
APF_BUNDLE_DIR=../../e2e/.work/compose/bundle-v1/bundle
APF_TRUST_ROOT=../../examples/dev-keys/apf-dev.pub

# OpenShell overlay (e2e/configs/compose/compose.openshell.yaml).
OPENSHELL_IMAGE_TAG=0.1.3
OPENSHELL_GATEWAY_ID=apf-compose
# docker | podman: selects e2e/configs/gateway/openshell-gateway.<driver>.toml
# and the engine the gateway drives sandboxes through.
OPENSHELL_COMPUTE_DRIVER=docker
# Engine API socket mounted into the OpenShell gateway container, as the
# engine resolves the bind source (inside a Podman machine: the machine's
# path, such as /run/user/<uid>/podman/podman.sock).
CONTAINER_SOCKET=/var/run/docker.sock
# Gateway state, bind-mounted at the same path inside the container so the
# engine can resolve paths the gateway hands it: an absolute, writable path,
# required by the overlay (no fallback). The harness uses
# <clone>/e2e/.work/compose/openshell-state and empties a state directory on
# `--down --volumes` only when it lies under e2e/.work. Set it to that
# directory before starting openshell-gateway by hand.
#OPENSHELL_STATE_DIR=/absolute/path/to/e2e/.work/compose/openshell-state
# Rendered gateway TOML; the harness writes an environment-adjusted copy of
# e2e/configs/gateway/openshell-gateway.<driver>.toml here.
OPENSHELL_GATEWAY_TOML=../../e2e/.work/compose/openshell-gateway.toml
# Published on 127.0.0.1: gateway gRPC, gateway health, egress request
# policy listener (reached by the host-network supervisor).
OPENSHELL_PORT=8080
OPENSHELL_HEALTH_PORT=8081
APF_EGRESS_PORT=9099
# Sandbox admission listener; pod-internal, not published.
APF_ADMISSION_PORT=18081
# Default image for `openshell sandbox create`. The Docker driver resolves the
# policy's run_as_user against the image, and the demo policy names `sandbox`,
# so the image must define that user.
SANDBOX_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base@sha256:e29a8e98c1399aa08a8c624d758d1814b6edbe0302eb570c0468a6d3e811d167

# grpcurl v1.9.3, used for the standalone decision over the gateway socket.
GRPCURL_IMAGE=fullstorydev/grpcurl@sha256:085e183ca334eb4e81ca81ee12cbb2b2737505d1d77f5e33dabc5d066593d998
