# Non-secret process settings read by apf-policy-gateway.service.
APF_GATEWAY_SOCKET=/run/apf/policy-gateway.sock
APF_POLICY_SERVICE_SOCKET=/run/apf/policy-service.sock
APF_DOCUMENT_KEY_ID=apf-prod
RUST_LOG=info
NO_COLOR=1

# APF <-> OpenShell interface. Bind loopback-only unless the OpenShell
# gateway/supervisor run on a different host; see SECURITY.md before
# widening either address off 127.0.0.1.
APF_OPENSHELL_INTERCEPTOR_ADDR=127.0.0.1:18202
APF_OPENSHELL_MIDDLEWARE_ADDR=127.0.0.1:9099

# apf-policy-service's own JWKS, used to verify provenance tokens on
# documents apf-policy-gateway fetches from it. Required whenever
# APF_OPENSHELL_INTERCEPTOR_ADDR is set. Point at the loopback address
# apf-policy-service's HTTP surface is bound to.
# Not the same thing as the OpenShell caller-auth block below — that's a
# separate trust domain belonging to OpenShell's gateway, not apf-policy-service.
APF_JWKS_URL=http://127.0.0.1:19200/.well-known/jwks.json

# Caller auth for the two addresses above: verifies the bearer token
# OpenShell attaches to its calls into this process. Required whenever the
# matching address is set — apf-policy-gateway refuses to start that surface
# otherwise. Each surface has its own trust file, TLS certificate, and TLS
# key — they are not interchangeable, even though they share a format. The
# trust file is a static, operator-provisioned TOML document (issuer,
# audience, signing kid, and OpenShell's Ed25519 public key) — see
# SECURITY.md for its exact schema and how to obtain the values from your
# OpenShell gateway's registration. TLS keys are loaded via LoadCredential in
# apf-policy-gateway.service, not from here. This unit's IPAddressAllow=localhost
# restricts the whole process to loopback, matching the co-located topology
# this deploy already assumes for the addresses above.
APF_OPENSHELL_INTERCEPTOR_AUTH_TRUST_FILE=/etc/apf/openshell-interceptor-auth.toml
APF_OPENSHELL_INTERCEPTOR_TLS_CERT_FILE=/etc/apf/tls/interceptor-cert.pem
APF_OPENSHELL_MIDDLEWARE_AUTH_TRUST_FILE=/etc/apf/openshell-middleware-auth.toml
APF_OPENSHELL_MIDDLEWARE_TLS_CERT_FILE=/etc/apf/tls/middleware-cert.pem

# Outbound call to the OpenShell gateway for provider-profile reconciliation
# and sandbox policy refresh. Leave unset unless that reconciliation flow is
# required; every outbound target from an APF/OpenShell host component must
# be an explicitly reviewed egress, same as a sandbox policy entry.
#APF_OPENSHELL_GATEWAY_URL=http://127.0.0.1:7001
