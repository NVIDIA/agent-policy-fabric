# Non-secret process settings read by apf-policy-service.service.
# EnvironmentFile is not a secret store: the bundle-source token, the
# document signing key, and the HTTP bearer token are loaded separately
# with LoadCredential in the unit.
APF_SOCKET=/run/apf/policy-service.sock
APF_BUNDLE_PATH=/etc/apf/bundle/bundle.yaml
APF_TRUST_ROOT_DIR=/etc/apf/trust-roots
APF_COUNTER_STORE=/var/lib/apf/policy-service/counter
APF_DOCUMENT_KEY_ID=apf-prod
APF_POLICY_SOURCE=local
APF_SURFACES=openshell.sandbox.v1,openshell.provider-profile.v1,apf.policy.v1
RUST_LOG=info
NO_COLOR=1

# To consume signed bundles from Artifactory instead of /etc/apf/bundle, switch
# the source to http and point at the stable latest tarball for one bundle.
# The paired `LoadCredential=bundle-source-token:...` line in
# apf-policy-service.service must also be enabled.
#APF_POLICY_SOURCE=http
#APF_BUNDLE_SOURCE_URL=<artifact-base-url>/signed-bundles/<bundle-name>/latest/<bundle-name>.tar.gz
#APF_BUNDLE_SOURCE_TOKEN_FILE=/run/credentials/apf-policy-service.service/bundle-source-token
#APF_BUNDLE_SOURCE_POLL_INTERVAL_SECS=60

# Leave unset to disable the HTTP surface entirely (the default). If set,
# the daemon refuses to start unless the paired `LoadCredential=http-bearer-
# token:...` line in apf-policy-service.service is also uncommented and
# /etc/apf/http-bearer-token exists — /v1/documents and /v1/refresh cannot
# be exposed without a token; /healthz and /readyz are always open either
# way. Loopback-only: do not widen this off 127.0.0.1 without a reviewed
# reason recorded here.
#APF_HTTP_ADDR=127.0.0.1:19200
