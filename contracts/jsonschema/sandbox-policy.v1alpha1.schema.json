{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NVIDIA/agent-policy-fabric/contracts/jsonschema/sandbox-policy.v1alpha1.schema.json",
  "title": "APF SandboxPolicy v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "nvidia.agent-policy-fabric.sandbox/v1alpha1" },
    "kind": { "const": "SandboxPolicy" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": { "$ref": "#/$defs/filesystem" },
        "landlock": { "$ref": "#/$defs/landlock" },
        "process": { "$ref": "#/$defs/process" },
        "network_policies": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/networkPolicyRule" }
        },
        "network_middlewares": {
          "type": "object",
          "maxProperties": 10,
          "additionalProperties": { "$ref": "#/$defs/networkMiddleware" }
        },
        "driver_config": { "$ref": "#/$defs/driverConfig" }
      }
    }
  },
  "$defs": {
    "driverConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "array",
          "items": { "$ref": "#/$defs/driverConfigAllow" }
        },
        "deny_templates": { "type": "boolean" }
      }
    },
    "driverConfigAllow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_role", "drivers", "max_mounts", "mounts"],
      "properties": {
        "require_role": { "type": "string", "minLength": 1 },
        "drivers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "max_mounts": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "mounts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/driverConfigMount" }
        }
      }
    },
    "driverConfigMount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_prefix", "target"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "source_prefix": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "read_only": { "type": "boolean" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "not": { "required": ["namespace"] },
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include_workdir": { "type": "boolean" },
        "read_only": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "read_write": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "landlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compatibility": { "enum": ["best_effort", "required", "disabled"] }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_as_user": { "type": "string", "minLength": 1 },
        "run_as_group": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicyRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/networkEndpoint" }
        },
        "binaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/networkBinary" }
        }
      }
    },
    "networkBinary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "harness": { "type": "boolean" }
      }
    },
    "networkEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "path": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "protocol": { "enum": ["tcp", "rest", "websocket", "graphql", "sql", "json-rpc", "mcp"] },
        "tls": { "enum": ["terminate", "passthrough"] },
        "enforcement": { "enum": ["enforce", "audit"] },
        "access": { "enum": ["read-only", "read-write", "full"] },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/l7Rule" }
        },
        "allowed_ips": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "deny_rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/l7DenyRule" }
        },
        "allow_encoded_slash": { "type": "boolean" },
        "websocket_credential_rewrite": { "type": "boolean" },
        "request_body_credential_rewrite": { "type": "boolean" },
        "persisted_queries": { "enum": ["deny", "allow_registered"] },
        "graphql_persisted_queries": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/graphqlOperation" }
        },
        "graphql_max_body_bytes": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "json_rpc_max_body_bytes": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "mcp": { "$ref": "#/$defs/mcpConfig" },
        "credential_binding": { "$ref": "#/$defs/networkCredentialBinding" },
        "allow_uninspected_credentials": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["port"] },
        { "required": ["ports"] }
      ],
      "allOf": [
        {
          "if": {
            "required": ["protocol"],
            "properties": { "protocol": { "const": "tcp" } }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["access"] },
                { "required": ["rules"] },
                { "required": ["deny_rules"] },
                { "required": ["enforcement"] }
              ]
            }
          }
        },
        {
          "not": {
            "required": ["access", "rules"]
          }
        },
        {
          "if": {
            "required": ["protocol"],
            "properties": { "protocol": { "enum": ["json-rpc", "mcp"] } }
          },
          "then": {
            "not": { "required": ["access"] }
          }
        },
        {
          "if": {
            "required": ["protocol"],
            "properties": { "protocol": { "const": "json-rpc" } }
          },
          "then": {
            "required": ["rules"],
            "properties": { "rules": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "required": ["protocol"],
            "properties": { "protocol": { "enum": ["rest", "websocket", "graphql", "sql"] } }
          },
          "then": {
            "anyOf": [
              { "required": ["access"] },
              {
                "required": ["rules"],
                "properties": { "rules": { "minItems": 1 } }
              }
            ]
          }
        },
        {
          "if": {
            "required": ["protocol"],
            "properties": { "protocol": { "const": "mcp" } }
          },
          "then": {
            "anyOf": [
              {
                "required": ["mcp"],
                "properties": {
                  "mcp": {
                    "required": ["allow_all_known_mcp_methods"],
                    "properties": { "allow_all_known_mcp_methods": { "const": true } }
                  }
                }
              },
              {
                "required": ["rules"],
                "properties": { "rules": { "minItems": 1 } }
              }
            ]
          }
        },
        {
          "if": {
            "required": ["deny_rules"],
            "properties": { "deny_rules": { "minItems": 1 } }
          },
          "then": {
            "required": ["protocol"],
            "properties": { "protocol": { "enum": ["rest", "websocket", "graphql", "sql", "json-rpc", "mcp"] } }
          }
        }
      ]
    },
    "l7Rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "allow": { "$ref": "#/$defs/l7Allow" }
      }
    },
    "l7Allow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "query": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/queryMatcher" }
        },
        "operation_type": { "enum": ["query", "mutation", "subscription", "*"] },
        "operation_name": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "params": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/queryMatcher" }
        }
      }
    },
    "l7DenyRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "query": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/queryMatcher" }
        },
        "operation_type": { "enum": ["query", "mutation", "subscription", "*"] },
        "operation_name": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "params": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/queryMatcher" }
        }
      }
    },
    "queryMatcher": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "graphqlOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_type": { "enum": ["query", "mutation", "subscription"] },
        "operation_name": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mcpConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_body_bytes": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "strict_tool_names": { "type": "boolean" },
        "allow_all_known_mcp_methods": { "type": "boolean" }
      }
    },
    "networkCredentialBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 }
      }
    },
    "networkMiddleware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "middleware": { "type": "string", "minLength": 1 },
        "on_error": { "enum": ["fail_closed", "fail_open"] },
        "order": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "endpoints": { "$ref": "#/$defs/middlewareEndpointSelector" }
      }
    },
    "middlewareEndpointSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclude": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
