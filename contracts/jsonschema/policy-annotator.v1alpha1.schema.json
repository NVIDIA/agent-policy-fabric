{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NVIDIA/agent-policy-fabric/contracts/jsonschema/policy-annotator.v1alpha1.schema.json",
  "title": "APF PolicyAnnotator v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "nvidia.agent-policy-fabric.policy/v1alpha1" },
    "kind": { "const": "PolicyAnnotator" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotation" }
        }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "not": { "required": ["namespace"] },
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "output"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "output": { "enum": ["bool", "string", "integer"] },
        "set_true_if": { "enum": ["any", "all"] },
        "set_value_from": { "const": "first_match" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotationRule" }
        }
      }
    },
    "annotationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "op": {
          "enum": [
            "regex_match",
            "equals",
            "endswith",
            "startswith",
            "contains",
            "length",
            "gte",
            "lte",
            "passthrough"
          ]
        },
        "pattern": { "type": "string" },
        "value": { "type": "string" },
        "suffix": { "type": "string" },
        "prefix": { "type": "string" },
        "substring": { "type": "string" },
        "threshold": { "type": "integer" }
      }
    }
  }
}
