{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NVIDIA/agent-policy-fabric/contracts/jsonschema/policy-finding.v1alpha1.schema.json",
  "title": "APF PolicyFinding v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "nvidia.agent-policy-fabric.policy/v1alpha1" },
    "kind": { "const": "PolicyFinding" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "severity"],
      "properties": {
        "description": { "type": "string" },
        "type": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "label": { "type": "string" },
        "label_source": { "type": "string" }
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["name"],
      "not": { "required": ["namespace"] },
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    }
  }
}
